GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret
SESSION_SECRET=replace-with-a-long-random-secret
GOOGLE_REDIRECT_URI=http://localhost:3000/auth/google/callback
SUPABASE_DATABASE_PASSWORD=your-supabase-database-password
SUPABASE_DATABASE_CONNECTION_STRING=postgresql://postgres:[YOUR-PASSWORD]@db.[PROJECT-REF].supabase.co:5432/postgres
# Download the CA certificate from Supabase Database settings to verify the TLS connection.
SUPABASE_DATABASE_SSL_CA=supabase/prod-supabase.cer
